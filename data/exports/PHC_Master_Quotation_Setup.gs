/**
 * Auto-populates default unit when Nick changes the project in Quotation!C2
 */
function onEdit(e) {
  if (!e || !e.range) return;
  const sheet = e.range.getSheet();
  if (sheet.getName() === "Quotation" && e.range.getA1Notation() === "C2") {
    const selectedProject = e.value;
    const projectDefaults = {
      "Time Square 8": "46B1",
      "Time Square 9": "10M2",
      "Time Square 11 (Time Castle XI)": "32S3",
      "Time Square 7": "45AO"
    };
    if (projectDefaults[selectedProject]) {
      sheet.getRange("C3").setValue(projectDefaults[selectedProject]);
    }
  }
}

function getOrCreateSheet(ss, name) {
  let s = ss.getSheetByName(name);
  if (!s) s = ss.insertSheet(name);
  return s;
}
