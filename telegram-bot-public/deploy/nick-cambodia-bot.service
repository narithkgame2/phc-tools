[Unit]
Description=Nick Cambodia Telegram bot (public Japanese investor bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nickbot
WorkingDirectory=/home/nickbot/phc-tools/telegram-bot-public
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
